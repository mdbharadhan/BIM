# Local dev default: SQLite via aiosqlite. Production target is PostgreSQL
# via asyncpg, e.g. postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=sqlite+aiosqlite:///./app.db

SQL_ECHO=false

# Convenience for local dev only — creates tables on startup via
# SQLAlchemy metadata. Set false anywhere Alembic (`alembic upgrade head`)
# is the actual source of truth (CI, staging, prod), to avoid schema drift
# being masked by an ad hoc create_all.
AUTO_CREATE_TABLES=true
